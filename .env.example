# =========================================================
# SARDIS AI V5.1.8 — Environment Configuration Template
# =========================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` — it contains secrets.

# --- HTTP Server ---
# Port the server listens on.
# Default (no value): 3000
PORT=3000

# --- Admin API key ---
# Required to protect admin endpoints (/api/memory, /api/session, ...)
# when requests do NOT come from loopback.
# In production (behind a proxy / public) set a strong random value.
# Leave empty to restrict admin endpoints to localhost only.
# Example: SARDIS_ADMIN_KEY=change-me-to-a-long-random-string
SARDIS_ADMIN_KEY=

# --- Ollama ---
# Base URL of the Ollama instance.
# Local default: http://127.0.0.1:11434
# For self-hosted production set your Ollama/VLLM service URL.
OLLAMA_URL=http://127.0.0.1:11434

# Model name to use.
# Default: qwen3:1.7b
OLLAMA_MODEL=qwen3:1.7b

# --- Optional Ollama tuning (defaults apply if omitted) ---
# OLLAMA_TIMEOUT=120000
# OLLAMA_CONTEXT=1024
# OLLAMA_PREDICT=96
# OLLAMA_KEEP_ALIVE=10m

# --- Optional behaviour toggles (defaults apply if omitted) ---
# MAX_MESSAGE_LENGTH=8000
# MAX_SESSION_MESSAGES=16
# SESSION_TTL=86400000
# RATE_MAX=30